# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (nuevo formato: sb_publishable_*) o anon key legacy
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Código de invitación (PIN estático para registro) ---
INVITATION_PIN=CAMBIAME-2026

# --- Proveedor de datos deportivos ---
# Elegir uno: "football-data" o "api-football"
FOOTBALL_PROVIDER=football-data
FOOTBALL_DATA_API_KEY=your-football-data-org-key
API_FOOTBALL_KEY=your-rapidapi-key

# --- Seguridad de endpoints cron ---
CRON_SECRET=cambia-este-secreto

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
